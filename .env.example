APP_NAME=RagTest API
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

QDRANT_URL=http://qdrant:6333
QDRANT_TIMEOUT_SECONDS=10
QDRANT_COLLECTION=ragtest_documents
# QDRANT_API_KEY=defina_apenas_se_usar_qdrant_com_autenticacao
# QDRANT_IMAGE=qdrant/qdrant:latest

SOURCE_DIR=data/source
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=.cache/fastembed
UPSERT_BATCH_SIZE=64

RETRIEVAL_CANDIDATE_MULTIPLIER=4
RETRIEVAL_SCORE_MARGIN=0.22
RETRIEVAL_MERGE_SAME_PAGE=true
RETRIEVAL_MAX_GROUP_CHARS=5000

LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=COLOQUE_SUA_NOVA_CHAVE_SOMENTE_NO_ARQUIVO_DOT_ENV_LOCAL
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=2400

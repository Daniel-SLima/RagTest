APP_NAME=RagTest API
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

QDRANT_URL=http://qdrant:6333
QDRANT_TIMEOUT_SECONDS=10
QDRANT_COLLECTION=ragtest_documents

SOURCE_DIR=data/source
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

PDF_OCR_ENABLED=true
PDF_OCR_LANGUAGE=por
PDF_OCR_DPI=200
PDF_OCR_TIMEOUT_SECONDS=60

EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=.cache/fastembed
UPSERT_BATCH_SIZE=64

SPARSE_EMBEDDING_PROVIDER=fastembed_bm25
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
SPARSE_EMBEDDING_LANGUAGE=portuguese

RETRIEVAL_MODE=dense-rerank
RETRIEVAL_MERGE_SAME_PAGE=true
RETRIEVAL_MAX_GROUP_CHARS=5000

LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=COLOQUE_SUA_NOVA_CHAVE_SOMENTE_NO_ARQUIVO_DOT_ENV_LOCAL

# Para usar GPT-OSS 120B via Groq:
# LLM_PROVIDER=groq
GROQ_API_KEY=COLOQUE_SUA_CHAVE_GROQ_SOMENTE_NO_ARQUIVO_DOT_ENV_LOCAL
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_REASONING_EFFORT=low
GROQ_REQUEST_TIMEOUT_SECONDS=120

# Para usar o Qwen3 8B local via Ollama no Docker:
# LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_CONTEXT_WINDOW=8192
OLLAMA_THINK=false
OLLAMA_REQUEST_TIMEOUT_SECONDS=180

LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=2400
LLM_SERVICE_RETRY_ATTEMPTS=2
LLM_SERVICE_RETRY_BASE_DELAY_SECONDS=1.0

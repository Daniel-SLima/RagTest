# Expo inlines variables prefixed with EXPO_PUBLIC_ into the client bundle.
# Web development on the same computer:
EXPO_PUBLIC_RAG_API_BASE_URL=http://localhost:8000

# Opt-in visual Demo M2 only; it is independent from backend DEMO_ENABLED.
# Set to true only when you want to display the local demo shell.
EXPO_PUBLIC_RAG_DEMO_ENABLED=false

# Android emulator example:
# EXPO_PUBLIC_RAG_API_BASE_URL=http://10.0.2.2:8000

# Physical device example (replace with the development computer LAN IP):
# EXPO_PUBLIC_RAG_API_BASE_URL=http://192.168.0.10:8000
